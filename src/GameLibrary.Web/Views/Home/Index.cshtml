@{
    ViewData["Title"] = "Home";
}
<p class="eyebrow">Your collection</p>
<h1>Game Library</h1>
<p class="intro">Browse your games, keep their details up to date, and find something to play.</p>
<div class="home-links">
    <section>
        <h2>Games</h2>
        <p>Search by title or notes, add games, and manage your collection.</p>
        <a asp-controller="Games" asp-action="Index">Browse games</a>
    </section>
    <section>
        <h2>Franchises</h2>
        <p>View franchises and maintain their names and developers.</p>
        <a asp-controller="Franchises" asp-action="Index">Browse franchises</a>
    </section>
    <section>
        <h2>Platforms</h2>
        <p>Explore the systems represented in your collection.</p>
        <a asp-controller="Platforms" asp-action="Index">Browse platforms</a>
    </section>
    <section>
        <h2>Administration</h2>
        <p>Add, edit, or remove the platform records used by games.</p>
        <a asp-controller="Administration" asp-action="Index">Manage platforms</a>
    </section>
    <section>
        <h2>Settings</h2>
        <p>Choose a light or dark appearance for your library.</p>
        <a asp-controller="Settings" asp-action="Index">Change settings</a>
    </section>
</div>
