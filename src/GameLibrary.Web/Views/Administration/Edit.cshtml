@model GameLibrary.Web.ViewModels.PlatformFormViewModel
@{ ViewData["Title"] = "Edit platform"; }
<h1>Edit platform</h1>
<form asp-action="Edit" method="post" class="record-form" asp-route-id="@Model.Id">
    @* Send the existing ID along with the editable fields. *@
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="validation"></div>
    <div><label asp-for="Name"></label><input asp-for="Name" />
        <span asp-validation-for="Name" class="validation"></span></div>
    <div><label asp-for="Manufacturer"></label><input asp-for="Manufacturer" />
        <span asp-validation-for="Manufacturer" class="validation"></span></div>
    <button type="submit">Save changes</button>
    <a asp-action="Index">Cancel</a>
</form>
