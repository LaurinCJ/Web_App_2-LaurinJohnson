@model GameLibrary.Data.Models.Platform
@{ ViewData["Title"] = "Delete platform"; }
<h1>Delete platform</h1>
<p>Are you sure you want to delete this platform?</p>
<dl>
    <dt>Name</dt><dd>@Model.Name</dd>
    <dt>Manufacturer</dt><dd>@Model.Manufacturer</dd>
</dl>
@* A referenced platform cannot be deleted; the controller explains it here. *@
<div asp-validation-summary="All" class="validation"></div>
<form asp-action="Delete" method="post">
    <input asp-for="Id" type="hidden" />
    <button type="submit" class="danger">Confirm deletion</button>
    <a asp-action="Index">Cancel</a>
</form>
