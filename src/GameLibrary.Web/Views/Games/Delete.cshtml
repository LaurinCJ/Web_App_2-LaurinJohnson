@model GameLibrary.Data.Models.Game
@{ ViewData["Title"] = "Delete game"; }
<h1>Delete game</h1>
<p>Are you sure you want to delete this game?</p>
<dl>
    <dt>Title</dt><dd>@Model.Title</dd>
    <dt>Release year</dt><dd>@Model.ReleaseYear</dd>
    <dt>Notes</dt><dd>@Model.Notes</dd>
    <dt>Franchise ID</dt><dd>@Model.FranchiseId</dd>
    <dt>Platform ID</dt><dd>@Model.PlatformId</dd>
</dl>
@* Controller errors such as a referenced franchise appear here. *@
<div asp-validation-summary="All" class="validation"></div>
<form asp-action="Delete" method="post">
    <input asp-for="Id" type="hidden" />
    <button type="submit" class="danger">Confirm deletion</button>
    <a asp-action="Index">Cancel</a>
</form>
