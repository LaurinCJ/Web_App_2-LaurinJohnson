@model IReadOnlyList<GameLibrary.Data.Models.Game>
@{
    ViewData["Title"] = "Games";
    string titleFilter = ViewData["TitleFilter"] as string ?? string.Empty;
    string notesFilter = ViewData["NotesFilter"] as string ?? string.Empty;
}
<h1>Games</h1>
<p><a asp-action="Create">Add a game</a></p>
<form asp-action="Index" method="get" class="search-form">
    <div><label for="title">Title contains</label>
        <input id="title" name="title" value="@titleFilter" /></div>
    <div><label for="notes">Notes contain</label>
        <input id="notes" name="notes" value="@notesFilter" /></div>
    <button type="submit">Search</button>
    <a asp-action="Index">Clear</a>
</form>
@if (Model.Count == 0)
{
    <p>No games match these filters.</p>
}
else
{
    <div class="table-container">
    <table>
        <thead><tr><th scope="col">Title</th><th scope="col">Year</th>
            <th scope="col">Notes</th><th scope="col">Actions</th></tr></thead>
        <tbody>
        @foreach (var game in Model)
        {
            <tr><td>@game.Title</td><td>@game.ReleaseYear</td><td>@game.Notes</td>
                <td class="actions">
                    <a asp-action="Details" asp-route-id="@game.Id">Details</a>
                    <a asp-action="Edit" asp-route-id="@game.Id">Edit</a>
                    <a asp-action="Delete" asp-route-id="@game.Id">Delete</a>
                </td></tr>
        }
        </tbody>
    </table>
    </div>
}
