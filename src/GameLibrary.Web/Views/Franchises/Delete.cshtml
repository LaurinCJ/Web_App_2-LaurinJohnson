@model GameLibrary.Data.Models.Franchise
@{ ViewData["Title"] = "Delete franchise"; }
<h1>Delete franchise</h1>
<p>Are you sure you want to delete this franchise?</p>
<dl>
    <dt>Name</dt><dd>@Model.Name</dd>
    <dt>Developer</dt><dd>@Model.Developer</dd>
</dl>
@* Controller errors such as a referenced franchise appear here. *@
<div asp-validation-summary="All" class="validation"></div>
<form asp-action="Delete" method="post">
    <input asp-for="Id" type="hidden" />
    <button type="submit" class="danger">Confirm deletion</button>
    <a asp-action="Index">Cancel</a>
</form>
